# -------- Core Paths --------
# Absolute path to dataset clips generated from ASLLVD
# Example (Windows): C:/Users/ashis/Downloads/STS-MVP-master/STS-MVP-master/asl_videos/words
ASL_WORDS_DIR=

# Optional override if your words folder is elsewhere
# ASL_WORDS_DIR=C:/path/to/asl_videos/words

# -------- MinIO (required for video URLs) --------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=genasl-videos

# -------- LLM Service (Ollama) --------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# -------- Whisper --------
# Use cpu if you do not have CUDA GPU
WHISPER_DEVICE=cpu
WHISPER_MODEL_SIZE=small
# For CPU use int8, for GPU float16
WHISPER_COMPUTE_TYPE=int8
