# GenASL Deployment Environment Variables
# These are defaults for Railway/cloud deployment

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production

# Database (optional - for future persistence)
# DATABASE_URL=postgresql://user:pass@localhost/genasllvd

# MinIO Configuration (use Railway service or local)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=asl-videos

# Ollama Configuration (use Railway service or fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Whisper Configuration
WHISPER_DEVICE=cpu
WHISPER_MODEL_SIZE=tiny
WHISPER_COMPUTE_TYPE=int8
ENABLE_STT=false

# ASL Dataset Paths
ASL_WORDS_DIR=/app/demo_data/words
ASL_POSES_DIR=/app/demo_data/poses
ASL_HEADS_DIR=/app/demo_data/heads

# Video Processing
MAX_VIDEO_LENGTH=30
OUTPUT_FORMAT=mp4
